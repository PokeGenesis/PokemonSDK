<Project>

  <PropertyGroup>
    <!-- Identité package — partagée par tous les packages NuGet -->
    <Authors>PokeGenesis</Authors>
    <Copyright>Copyright © 2026 PokeGenesis</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PokeGenesis/PokemonSDK</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PokeGenesis/PokemonSDK</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>pokegenesis_logo.png</PackageIcon>

    <!-- Par défaut : rien n'est packable.
         Les 7 projets SDK déclarent explicitement <IsPackable>true</IsPackable>. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>


  <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 est la derniere version disponible (juin 2026).
       Aucun correctif upstream — suppression ciblee jusqu a publication d une version patchee.
       Recheck: https://github.com/advisories/GHSA-2m69-gcr7-jv3q -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

    <!-- Bundler README.md + icône (racine repo) dans chaque package NuGet -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)pokegenesis_logo.png"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>
