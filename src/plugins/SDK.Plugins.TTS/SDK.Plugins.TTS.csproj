<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\SDK.Core\SDK.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <PackageId>PokeForge.SDK.Plugins.TTS</PackageId>
    <Version>0.1.0</Version>
    <Description>Plugin TTS (Text-To-Speech) pour PokemonSDK. Narration multi-plateforme : Windows SAPI, Piper TTS, Null fallback.</Description>
    <PackageTags>pokemon;fan-game;tts;narration;plugin;dotnet;sdk</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>
