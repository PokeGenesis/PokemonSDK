<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SDK.Core\SDK.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PokeForge.SDK.Scripting</PackageId>
    <Version>0.1.0</Version>
    <Description>Scripting Lua pour PokemonSDK via MoonSharp Preset_SoftSandbox. GameState, SaveSystem JSON, coroutines, hot reload.</Description>
    <PackageTags>pokemon;fan-game;lua;scripting;moonsharp;dotnet;sdk</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

</Project>
