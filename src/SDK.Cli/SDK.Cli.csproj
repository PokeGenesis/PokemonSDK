<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SDK.Cli</AssemblyName>
    <RootNamespace>PokeForge.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pokeforge</ToolCommandName>
    <PackageId>PokeForge.CLI</PackageId>
    <Version>0.2.0</Version>
    <Description>CLI tool for PokeForge SDK — scaffold, asset-sync, seed, doctor.</Description>
    <Authors>PokeGenesis</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/PokeGenesis/PokemonSDK</RepositoryUrl>
    <PackageProjectUrl>https://github.com/PokeGenesis/PokemonSDK</PackageProjectUrl>
    <PackageTags>pokemon;fan-game;dotnet-tool;cli;pokeforge</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SDK.Tools/SDK.Tools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Templates/starter-template.zip">
      <LogicalName>starter-template.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SDK.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
